      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="KONTROL S1: son bakiye = başarılı yatırma sayısı × 1 TL">
          <stringProp name="HTTPSampler.path">${TEMEL}/accounts/${__P(YATIRMA_HESABI)}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Kayıp güncelleme var mı?">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def bakiye = (json.balance as BigDecimal)
def basarili = props.get("yatirmaBasarili").get()
def mesaj = "S1 son bakiye=" + bakiye + " TL, başarılı yatırma=" + basarili + " (beklenen bakiye=" + basarili + " TL)"
log.info(mesaj)
prev.setResponseMessage(mesaj)
if ((bakiye - basarili).abs() &gt; 0.001) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("TUTARSIZ (lost update?): " + mesaj)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="KONTROL S2a: A hesabı bakiyesi">
          <stringProp name="HTTPSampler.path">${TEMEL}/accounts/${__P(HESAP_A)}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="A bakiyesi">
            <stringProp name="JSONPostProcessor.referenceNames">BAKIYE_A</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.balance</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NaN</stringProp>
          </JSONPostProcessor>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="KONTROL S2b: A + B toplamı 20.000 TL olmalı (G-5)">
          <stringProp name="HTTPSampler.path">${TEMEL}/accounts/${__P(HESAP_B)}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Para yoktan var / yok oldu mu?">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def b = (json.balance as BigDecimal)
def a = new BigDecimal(vars.get("BAKIYE_A"))
def toplam = a + b
def mesaj = "S2 A=" + a + " B=" + b + " toplam=" + toplam + " (beklenen 20000)"
log.info(mesaj)
prev.setResponseMessage(mesaj)
if ((toplam - 20000).abs() &gt; 0.001) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage("TUTARSIZ (G-5): " + mesaj)
}</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="KONTROL S3: açılan hesap numaraları benzersiz mi (R-1.5)">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">def liste = new ArrayList(props.get("acilanHesaplar"))
def kume = new HashSet(liste)
def bicimHatali = liste.findAll { !(it ==~ /[1-9][0-9]{9}/) }
def mesaj = "S3 açılan=" + liste.size() + " benzersiz=" + kume.size() + " biçim hatalı=" + bicimHatali.size()
log.info(mesaj)
SampleResult.setResponseMessage(mesaj)
SampleResult.setResponseData(mesaj, "UTF-8")
if (kume.size() != liste.size() || !bicimHatali.isEmpty()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode("500")
} else {
    SampleResult.setResponseCode("200")
