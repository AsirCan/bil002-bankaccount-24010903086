<?xml version="1.0" encoding="UTF-8"?>
<!--
  BIL 002 · BankAccount API yük ve eşzamanlılık testi (canlı servis)
  Çalıştırma (GUI değil, komut satırı):
    jmeter -n -t performans/bankaccount-yuk-testi.jmx -Jtoken=<TOKEN> -Jjmeter.save.saveservice.url=false
           -l performans/sonuclar/sonuc.csv -e -o performans/sonuclar/html
  GİZLİLİK: token bu dosyada YOK. ${__P(token)} ile komut satırından gelir.
  Senaryolar sırayla koşar (serialize_threadgroups):
    S1 yük: 50 kullanıcı × 60 sn, aynı hesaba 1 TL yatırma + bakiye sorgulama
    S2 eşzamanlı transfer: 20 kullanıcı × 30 sn, iki hesap arasında karşılıklı 10 TL (G-5)
    S3 eşzamanlı hesap açma: 20 kullanıcı × 10 hesap, numaralar benzersiz mi? (R-1.5)
  tearDown: bakiye tutarlılığı doğrulamaları (JSR223 Assertion, Groovy).
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="BankAccount yük ve eşzamanlılık testi">
