{
  "info": {
    "name": "BIL002 BankAccount API",
    "description": "BIL 002 dönem projesi · her endpoint için en az bir başarılı ve bir hatalı istek. Adres {{baseUrl}} ortam değişkeninden gelir. Hesap numaraları istekler arasında hesapNo / hedefNo ortam değişkenleriyle taşınır. Sıra önemlidir: Collection Runner ile baştan sona koşun.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API-01: Hesap aç (geçerli STANDARD)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test(\"ACTIVE ve 10 haneli numara\", () => { pm.expect(j.status).to.eql(\"ACTIVE\"); pm.expect(j.accountNumber).to.match(/^[1-9][0-9]{9}$/); });",
              "pm.environment.set(\"hesapNo\", j.accountNumber);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "User-Agent",
            "value": "Mozilla/5.0 (BIL002 Postman)"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"ownerName\":\"Postman Kullanıcı\",\"accountType\":\"STANDARD\",\"initialBalance\":1000}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
